package "wasm_of_ocaml-compiler" {
  opam-version: "2.0"
  version: "6.5.0"
  synopsis: "Compiler from OCaml bytecode to WebAssembly"
  description:
    "Wasm_of_ocaml is a compiler from OCaml bytecode to WebAssembly. It makes it possible to run pure OCaml programs in JavaScript environment like browsers and Node.js"
  maintainer: "Ocsigen team <dev@ocsigen.org>"
  authors: "Ocsigen team <dev@ocsigen.org>"
  license: [
    "GPL-2.0-or-later" "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
  ]
  homepage:
    "https://ocsigen.org/js_of_ocaml/latest/js_of_ocaml/overview.html"
  doc: "https://ocsigen.org/js_of_ocaml/latest/js_of_ocaml/overview.html"
  bug-reports: "https://github.com/ocsigen/js_of_ocaml/issues"
  depends: [
    "dune" {>= "3.20"}
    "ocaml" {>= "4.14"}
    "js_of_ocaml" {= version}
    "num" {with-test}
    "out-channel-redirect" {with-test}
    "ppxlib" {>= "0.33"}
    "re" {with-test}
    "cmdliner" {>= "2.0"}
    "sedlex" {>= "2.3"}
    "menhir" {>= "20180523"}
    "menhirLib"
    "menhirSdk"
    "yojson" {>= "2.1"}
    "conf-binaryen"
    "odoc" {with-doc}
  ]
  depopts: ["ocamlfind" "opam-format" "binaryen-bin"]
  conflicts: [
    "ocamlfind" {< "1.5.1"}
    "js_of_ocaml" {< "3.0"}
  ]
  build: [
    ["dune" "build" "-p" name "-j" jobs "@install" "@doc" {with-doc}]
    [
      "cmdliner"
      "install"
      "tool-support"
      "--update-opam-install=%{_:name}%.install"
      "_build/install/default/bin/wasm_of_ocaml" {os-family != "windows"}
      "_build/install/default/bin/wasm_of_ocaml.exe:wasm_of_ocaml"
        {os-family = "windows"}
      "_build/cmdliner-install"
    ]
  ]
  dev-repo: "git+https://github.com/ocsigen/js_of_ocaml.git"
  url {
    src:
      "https://github.com/ocsigen/js_of_ocaml/releases/download/6.5.0/js_of_ocaml-6.5.0.tbz"
    checksum: [
      "sha256=a991ce25175a5a13240c8bf64354b8f35e0a8d7223b90bef01ba32bc6f929cf4"
